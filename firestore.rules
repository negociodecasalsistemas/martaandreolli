rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null && request.auth.token.email_verified == true; }
    function isOwner() { return signed() && request.auth.token.email == 'excellentservices.excel@gmail.com'; }
    function isAdmin() { return isOwner() || (signed() && exists(/databases/$(database)/documents/admins/$(request.auth.token.email))); }

    // conteúdo do site e cache do Google: todos leem, só administradores escrevem
    match /site/{doc} {
      allow read: if doc != 'google';
      allow write: if isAdmin();
    }
    // configuração privada (contém a chave da API): só administradores
    match /site/google {
      allow read, write: if isAdmin();
    }

    // imagens do site guardadas em base64 (já reduzidas pelo painel): todos leem, só administradores escrevem
    match /imgs/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['d','w','h','by','at'])
        && request.resource.data.d is string
        && request.resource.data.d.matches('data:image/.*')
        && request.resource.data.d.size() < 900000;
      allow delete: if isAdmin();
    }

    // quem pode editar: só a dona libera ou remove
    match /admins/{email} {
      allow read: if signed() && (isAdmin() || request.auth.token.email == email);
      allow write: if isOwner();
    }
    // clientes que fizeram login no site
    match /users/{uid} {
      allow create, update: if signed() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email','name','photo','lastLogin'])
        && request.resource.data.email == request.auth.token.email;
      allow read: if signed() && (request.auth.uid == uid || isAdmin());
    }

    // horários reservados: todos veem QUAIS horários estão ocupados (sem dados pessoais).
    // O id do documento é data_hora, então dois agendamentos no mesmo horário são impossíveis.
    match /slots/{sid} {
      allow read: if true;
      allow create: if isAdmin() || (signed()
        && request.resource.data.keys().hasOnly(['date','t','status','uid','bid'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pendente'
        && sid == request.resource.data.date + '_' + request.resource.data.t.replace(':', ''));
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signed() && resource.data.uid == request.auth.uid);
    }

    // agendamentos (dados da cliente): só a própria cliente e os administradores
    match /bookings/{id} {
      allow read: if signed() && (isAdmin() || resource.data.uid == request.auth.uid);
      allow create: if isAdmin() || (signed()
        && request.resource.data.keys().hasOnly(['uid','email','nome','sobrenome','tel','wa','svc','svcName','opt','price','date','t','status','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pendente');
      // administradores também criam agendamentos manuais (aba Marcar do painel)
      // só administradores confirmam; a cliente só pode cancelar o próprio agendamento
      allow update: if isAdmin() || (signed()
        && resource.data.uid == request.auth.uid
        && request.resource.data.status == 'cancelado'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','cancelledAt']));
      allow delete: if isAdmin();
    }
  }
}
