rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /site/{file=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email_verified == true
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && (request.auth.token.email == 'excellentservices.excel@gmail.com'
            || firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email)));
    }
  }
}
